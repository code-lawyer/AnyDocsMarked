[
  {
    "id": "ocr_quality_check",
    "promise": "输出质检标记（低字符/乱码/重复/低置信）默认启用，不静默放过可疑转换",
    "owner": "makeitdown",
    "tier": "FLOOR",
    "phase": "ingest",
    "enforcement": "makeitdown 默认 quality_check=True；ingest 的 build_convert_argv 绝不产出 --no-quality-check",
    "sanctioned": {
      "forbid_flag": "--no-quality-check",
      "default_on": true
    }
  },
  {
    "id": "source_reconcile",
    "promise": "三态覆盖账本 + 源级对账：每个源文件已引用/已登记跳过/未处置",
    "owner": "lawiki",
    "tier": "FLOOR",
    "phase": "ingest",
    "enforcement": "ingest.main 必调 _run_reconcile；未处置>0 完整性门返回非 0",
    "sanctioned": {
      "assert": "ingest.main 调 _run_reconcile",
      "default_on": true
    }
  },
  {
    "id": "rag_hybrid",
    "promise": "BM25 + 向量混合检索（RRF），法律近义术语精确召回",
    "owner": "rag",
    "tier": "FLOOR",
    "phase": "ingest",
    "enforcement": "rag Config.hybrid 默认 True（由 rag 自身测试套件强制）",
    "sanctioned": {
      "env": "RAG_HYBRID",
      "default_on": true
    }
  },
  {
    "id": "provenance_sha",
    "promise": "原件与转换正文写入双 SHA-256，ingest 闸门复核",
    "owner": "makeitdown",
    "tier": "FLOOR",
    "phase": "ingest",
    "enforcement": "makeitdown frontmatter 默认写 origin/body sha256（由 makeitdown 自身测试强制）",
    "sanctioned": {
      "assert": "frontmatter 写 origin/body sha256",
      "default_on": true
    }
  },
  {
    "id": "ocr_rotation",
    "promise": "扫描件旋转纠偏：识别前选正向，避免旋转页 OCR 乱码",
    "owner": "makeitdown",
    "tier": "FLOOR",
    "phase": "ingest",
    "enforcement": "makeitdown convert_ocr 集成 ocr_rotate.best_rotation_angle（低置信触发；由 makeitdown 自身测试强制）",
    "sanctioned": {
      "assert": "convert_ocr 集成 ocr_rotate（低置信触发）",
      "default_on": true
    }
  },
  {
    "id": "answer_gate",
    "promise": "问答后闸门：回答含未锚定事实即拦（宁可查不出，也不编造）",
    "owner": "lawiki",
    "tier": "FLOOR",
    "phase": "answer",
    "enforcement": "install._check_answer_gate_ready 检测 stop_hook 就绪并告警；stop_hook 在 harness 每次回复确定性校验锚点",
    "sanctioned": {
      "assert": "install._check_answer_gate_ready 检测 stop_hook 并告警",
      "default_on": true
    }
  },
  {
    "id": "ocr_engine",
    "promise": "OCR 引擎选择：本地（文件不出机）vs 云端（轻快、需上传+同意）",
    "owner": "makeitdown",
    "tier": "CHOICE",
    "phase": "ingest",
    "tradeoff": "本地 PaddleOCR 私密但重装/较慢；云端 AI Studio 轻快但上传正文、需 token + 显式同意",
    "enforcement": "makeitdown --ocr-engine/--cloud-consent 代码门（require_cloud_consent）；token 经子进程 env",
    "inputs": [
      {
        "id": "engine",
        "label": "OCR 引擎",
        "kind": "select",
        "options": [
          "auto",
          "local",
          "cloud"
        ],
        "flag": "--ocr-engine",
        "default": "auto"
      },
      {
        "id": "cloud_token",
        "label": "云端 OCR token（云端/auto 用）",
        "kind": "secret",
        "env": "PADDLEOCR_AISTUDIO_TOKEN",
        "required_when": {
          "engine": [
            "cloud"
          ]
        }
      },
      {
        "id": "cloud_consent",
        "label": "我同意：云端会上传文档",
        "kind": "bool",
        "flag": "--cloud-consent",
        "required_when": {
          "engine": [
            "cloud"
          ]
        }
      }
    ],
    "knobs": [
      "--cloud-token"
    ]
  },
  {
    "id": "ocr_cross_check",
    "promise": "金额/日期错一位就是事故 —— 双 OCR 互校 + 数字/日期位专项比对",
    "owner": "makeitdown",
    "tier": "CHOICE",
    "phase": "ingest",
    "tradeoff": "更慢、需第二引擎（MinerU 本地或云端 token）；换来抓出两引擎的金额/日期识别分歧",
    "enforcement": "makeitdown --ocr-cross-check + verifier 代码路径；token 经子进程 env",
    "inputs": [
      {
        "id": "cross_check_mode",
        "label": "校验器位置（本地/云端/双云端）",
        "kind": "select",
        "options": [
          "cloud",
          "local",
          "auto"
        ],
        "flag": "--cross-check-mode",
        "default": "cloud"
      },
      {
        "id": "mineru_token",
        "label": "MinerU 云端 token（云端/双云端校验时需要）",
        "kind": "secret",
        "env": "MINERU_API_TOKEN",
        "required_when": {
          "cross_check_mode": [
            "cloud",
            "auto"
          ]
        }
      }
    ],
    "sanctioned": {
      "ingest_flag": "--ocr-cross-check",
      "gui_control": "cross_check",
      "default_on": false
    }
  },
  {
    "id": "structure_headings",
    "promise": "LLM 重建 OCR 输出的标题层级，改善结构感知分块",
    "owner": "makeitdown",
    "tier": "CHOICE",
    "phase": "ingest",
    "tradeoff": "需 LLM 凭证 + consent，会把正文外传给 LLM；换来更准的标题层级",
    "enforcement": "makeitdown --structure-headings 代码路径；LLM 凭证经子进程 env",
    "inputs": [
      {
        "id": "llm_base_url",
        "label": "LLM base_url",
        "kind": "text",
        "env": "MAKEITDOWN_LLM_BASE_URL"
      },
      {
        "id": "llm_model",
        "label": "LLM 模型名",
        "kind": "text",
        "env": "MAKEITDOWN_LLM_MODEL"
      },
      {
        "id": "llm_api_key",
        "label": "LLM API key",
        "kind": "secret",
        "env": "MAKEITDOWN_LLM_API_KEY"
      }
    ],
    "sanctioned": {
      "ingest_flag": "--structure-headings",
      "gui_control": "structure_headings",
      "default_on": false
    },
    "knobs": [
      "--llm-base-url",
      "--llm-model",
      "--llm-api-key"
    ]
  },
  {
    "id": "rag_parent_context",
    "promise": "small-to-big 检索：索引细粒度子块、返回父块上下文",
    "owner": "rag",
    "tier": "CHOICE",
    "phase": "ingest",
    "tradeoff": "索引更细、体积更大、建索引更慢；换来命中片段带更完整上下文",
    "enforcement": "ingest 建索引前设 RAG_PARENT_CONTEXT，rag 子进程消费",
    "sanctioned": {
      "ingest_flag": "--rag-parent-context",
      "env": "RAG_PARENT_CONTEXT",
      "gui_control": "parent_context",
      "default_on": false
    }
  },
  {
    "id": "rag_install",
    "promise": "语义检索（交叉验证问答）：装 rag-retriever + 选本地 embedding 后端",
    "owner": "lawiki",
    "tier": "CHOICE",
    "phase": "install",
    "tradeoff": "默认开/强烈推荐——关闭 = 无 wiki×RAG 交叉验证、信任等级下降；后端只本地（local 内置 / 本地 ollama bge-m3）",
    "enforcement": "GUI 直接 subprocess 跑 install.py；后端经 case.json 由 rag.py 注入、索引期落盘 .rag/",
    "inputs": [
      {
        "id": "embed_backend",
        "label": "embedding 后端（均本地）",
        "kind": "select",
        "options": [
          "local",
          "ollama"
        ],
        "env": "RAG_EMBED_BACKEND",
        "default": "local",
        "answer_persist": true
      },
      {
        "id": "ollama_url",
        "label": "ollama 地址（仅 loopback）",
        "kind": "text",
        "env": "RAG_OLLAMA_URL",
        "required_when": {
          "embed_backend": [
            "ollama"
          ]
        }
      }
    ]
  },
  {
    "id": "ocr_install",
    "promise": "OCR 安装：装本地 OCR 重包（离线/私密）还是仅用云端（轻、需 token）",
    "owner": "lawiki",
    "tier": "CHOICE",
    "phase": "install",
    "tradeoff": "本地 makeitdown[local] 几百 MB、吃算力；云端免装但转换时上传",
    "enforcement": "GUI 直接 subprocess 跑 install.py --ocr <local|cloud>",
    "inputs": [
      {
        "id": "ocr_pkg",
        "label": "OCR 安装方式",
        "kind": "select",
        "options": [
          "local",
          "cloud"
        ],
        "flag": "--ocr",
        "default": "cloud"
      }
    ]
  },
  {
    "id": "answer_gate_install",
    "promise": "启用问答后闸门 stop_hook：回答含未锚定事实即被 harness 拦下",
    "owner": "lawiki",
    "tier": "CHOICE",
    "phase": "install",
    "tradeoff": "开启 = '不编造' 在问答时被自动强制；不开则只靠 agent 自觉跑 lint answer",
    "enforcement": "GUI 勾选后往案件本地 .claude/settings.json 写 Stop hook（不碰用户全局）",
    "sanctioned": {
      "gui_control": "enable_stop_hook",
      "default_on": false
    }
  },
  {
    "id": "rag_rerank",
    "promise": "交叉编码器重排，提升检索精排质量",
    "owner": "rag",
    "tier": "CHOICE",
    "phase": "answer",
    "tradeoff": "查询期能力：更慢、需联网下载重排模型；由答案侧 RAG_RERANK 启用",
    "enforcement": "rag.py 读 case.json 注入 RAG_RERANK 到 rag 子进程（工具确定性注入，非委托）",
    "sanctioned": {
      "env": "RAG_RERANK",
      "gui_control": "rerank",
      "default_on": false,
      "answer_persist": true
    }
  },
  {
    "id": "rag_min_score",
    "promise": "向量通道相关度下限，滤掉弱命中",
    "owner": "rag",
    "tier": "CHOICE",
    "phase": "answer",
    "tradeoff": "查询期能力：设太高会漏检、太低无效；由答案侧 RAG_MIN_SCORE 启用",
    "enforcement": "rag.py 读 case.json 注入 RAG_MIN_SCORE 到 rag 子进程（工具确定性注入，非委托）",
    "sanctioned": {
      "env": "RAG_MIN_SCORE",
      "default_on": false
    },
    "inputs": [
      {
        "id": "min_score",
        "label": "相关度下限 0~1",
        "kind": "text",
        "env": "RAG_MIN_SCORE",
        "answer_persist": true
      }
    ]
  },
  {
    "id": "unresolved_disposition",
    "promise": "未处置源文件裁决：转换失败/不支持的文件由用户决定重试或登记跳过",
    "owner": "lawiki",
    "tier": "CHOICE",
    "phase": "ingest",
    "tradeoff": "不处置则完整性门保持非 0（未处置>0 即拦）；登记跳过需给非空原因",
    "enforcement": "GUI done 屏列出让用户裁决；写 log.md skip 条目；reconcile 门确定性拦截",
    "sanctioned": {
      "gui_control": "unresolved_disposition",
      "default_on": false
    }
  },
  {
    "id": "tuning_and_infra_knobs",
    "promise": "",
    "owner": "lawiki",
    "tier": "OUT",
    "rationale": "调优或基础设施旋钮，非'错一位就出事'的信任/隐私决策；暴露反而诱导放松安全阈值。登记于此仅为完备性账本，不进 GUI。",
    "knobs": [
      "--keep-images",
      "--ocr-model",
      "--output",
      "-o",
      "--report",
      "--skip-existing",
      "--strict",
      "--text-threshold",
      "--workers",
      "--warn-cross-check-ratio",
      "--warn-garbled-ratio",
      "--warn-min-chars",
      "--warn-min-chars-per-page",
      "--warn-min-confidence",
      "--warn-repeat-count",
      "--llm-max-heading-len",
      "--llm-max-heading-ratio",
      "--llm-max-lines",
      "--data-dir",
      "-k",
      "--exclude",
      "--filter",
      "--fix",
      "--json",
      "--metadata-fields",
      "--no-recursive",
      "--show-parent",
      "--source-root",
      "RAG_CHUNK_OVERLAP",
      "RAG_CHUNK_STRATEGY",
      "RAG_CHUNK_TOKENS",
      "RAG_DATA_DIR",
      "RAG_EMBED_BATCH_SIZE",
      "RAG_EMBED_MODEL",
      "RAG_EMBED_MODEL_PATH",
      "RAG_HYBRID_CANDIDATES",
      "RAG_METADATA_FIELDS",
      "RAG_PARENT_TOKENS",
      "RAG_RERANK_MODEL",
      "RAG_RRF_K"
    ]
  },
  {
    "id": "keep_images",
    "promise": "",
    "owner": "makeitdown",
    "tier": "OUT",
    "rationale": "扫描图片留存是排版偏好，非承诺相关（其标志 --keep-images 已登记在 tuning_and_infra_knobs）。"
  }
]
